# Mantiene despierta la base de Supabase (el plan gratis la pausa después de 7 días sin uso).
# Va en el repositorio en la ruta:  .github/workflows/keepalive.yml
name: Mantener Supabase despierto

on:
  schedule:
    - cron: '0 12 */3 * *'   # cada 3 días, 9 hs de Argentina
  workflow_dispatch:          # botón "Run workflow" para probarlo a mano

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Consultar la base
        run: |
          curl -sS -f -X POST "https://fycqjwxljwsqqibnkdtc.supabase.co/rest/v1/rpc/boda_invitacion" \
            -H "apikey: sb_publishable_OP0gMdG6lNrWP-XO0M0UUA_q-hVWBHg" \
            -H "Content-Type: application/json" \
            -d '{"p_codigo":"PING00"}'
